# Copy to backend/.env.local and fill in. Gitignored.
# Server-side only. Never prefix these with VITE_ — that would ship them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq LLM extraction (for Edge Function / local dev)
GROQ_API_KEY=
LLM_MODEL=groq/compound-mini
